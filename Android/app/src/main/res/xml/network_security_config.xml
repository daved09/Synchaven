<?xml version="1.0" encoding="utf-8"?>
<!--
    SyncHaven servers are usually self-hosted:
    - unencrypted http:// is allowed for servers on the home network
    - user-installed certificate authorities (e.g. your own CA) are accepted as well
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
