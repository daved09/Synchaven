<?xml version="1.0" encoding="utf-8"?>
<!-- Credentials (token) belong neither in cloud backups nor in device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/synchaven.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/synchaven.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
