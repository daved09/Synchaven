<?xml version="1.0" encoding="utf-8"?>
<!-- Anmeldedaten (Token) gehören weder in Cloud-Sicherungen noch in Geräteübertragungen. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/synchaven.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/synchaven.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
