{
  "name": "synchaven-web",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-i18n.mjs && vite build",
    "typecheck": "vue-tsc --noEmit && tsc -p e2e/tsconfig.json",
    "preview": "vite preview",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@mdi/font": "^7.4.47",
    "pinia": "^3.0.4",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^4.6.5",
    "vuetify": "^3.13.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
